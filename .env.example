# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Required ---
OPENAI_API_KEY=sk-proj-...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_rec_monitor

# --- AI Providers (add whichever you use in runs) ---
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=           # only needed if using Gemini provider

# --- Integrations (optional) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Outreach scripts (optional, not used by the web app) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
APOLLO_API_KEY=
HUNTER_API_KEY=
